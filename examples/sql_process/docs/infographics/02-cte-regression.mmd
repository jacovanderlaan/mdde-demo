flowchart LR
    classDef versionA fill:#fee2e2,stroke:#991b1b,color:#7f1d1d
    classDef versionB fill:#bbf7d0,stroke:#166534,color:#14532d
    classDef engine fill:#dbeafe,stroke:#1e40af,color:#1e3a8a
